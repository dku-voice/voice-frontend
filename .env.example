# API 주소는 배포에서 빈 값: /api/... 상대 경로 사용
VITE_API_BASE_URL=
# 빈 값이면 현재 페이지 host의 /ws/audio 사용
VITE_AI_WS_URL=
VITE_STORE_ID=store-default
# 기존 snapshot multipart 계약이 확인된 주소만 설정 (AI 연령 API와 혼동 금지)
VITE_AI_SNAPSHOT_URL=
# 공개 테스트 클라이언트 키만 사용
VITE_TOSS_CLIENT_KEY=
# Vite 로컬 개발 프록시. 로컬 백엔드는 http://127.0.0.1:8080
BACKEND_PROXY_TARGET=https://dku-voice.com
